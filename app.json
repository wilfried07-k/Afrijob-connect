{
  "expo": {
    "name": "afrijob-connect",
    "slug": "afrijob-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wilfiriedkana.afrijobconnect"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-status-bar",
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Autorisez l’accès aux photos pour joindre des documents de conformité.",
          "cameraPermission": "Autorisez l’accès à la caméra pour photographier les documents de conformité et réaliser un selfie.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bec99197-5af2-4838-9f04-1085bdac5b0a"
      }
    }
  }
}
